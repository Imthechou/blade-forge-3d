{
  "name": "blade-forge",
  "version": "3.0.0",
  "private": true,
  "description": "锻刀大赛 BLADE FORGE —— 浏览器端 3D 锻造 / Roguelike / 锦标赛（无构建步骤，静态站点 + 诊断探针）",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "ai:index": "node tools/project.mjs index",
    "bake:handle-atlas": "node tools/bake-handle-atlas.mjs",
    "check": "node tools/project.mjs check",
    "index": "node tools/project.mjs index",
    "serve": "node serve.cjs 8123 127.0.0.1",
    "verify:handle-atlas": "node tools/bake-handle-atlas.mjs --verify",
    "start": "node tools/launch.cjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tools/verify-browser.mjs",
    "verify": "npm run check && npm test"
  },
  "comment": "游戏与核心测试无需安装依赖、无需构建。npm start 自动启动并打开浏览器。浏览器自动验收需 npm install --no-save --package-lock=false playwright 或通过 PLAYWRIGHT_MODULE 指定已有模块，浏览器路径可用 CHROME_PATH 指定。",
  "devDependencies": {},
  "type": "module"
}
